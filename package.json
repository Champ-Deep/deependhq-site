{
  "name": "deependhq-site",
  "private": true,
  "version": "1.0.0",
  "description": "deependhq.com. Static assets plus a Cloudflare Worker. Published by scripts/publish.sh.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-data.mjs && node scripts/prerender.mjs",
    "build:data": "node scripts/build-data.mjs",
