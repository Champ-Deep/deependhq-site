# Cache rules for plain static assets (Cloudflare Workers static assets).
# Routes in run_worker_first are served by the Worker and ignore this file.
# fonts/* is immutable only because the Fraunces files carry a -v2 name:
# any future change to a font file needs a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=86400
