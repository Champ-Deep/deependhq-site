{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deependhq",
  "compatibility_date": "2026-05-23",
  "observability": {
    "enabled": true
  },
  "//main": "Adds worker/index.js to what was a static assets-only deployment. Assets still serve every file; the Worker adds /cta, the /field-notes and /companies redirects, POST /api/decide, GET /showcase, and the HTMLRewriter pass.",
  "main": "worker/index.js",
  "//routes": "CRITICAL: list EVERY custom domain. wrangler deploy replaces the Worker's whole custom-domain set (changeset replace_state=true), so a list with only toolkit.deependhq.com would detach the apex and www and take the site down.",
  "routes": [
    { "pattern": "deependhq.com", "custom_domain": true },
    { "pattern": "www.deependhq.com", "custom_domain": true },
    { "pattern": "toolkit.deependhq.com", "custom_domain": true }
  ],
  "//d1": "Toolkit wallet and credit ledger. Created 2026-10-28; schema in migrations/, applied with: npx wrangler d1 migrations apply toolkit-db --remote. Every cap and grant defaults to 0 (fail closed) until set from the Admin app.",
  "d1_databases": [
    { "binding": "TOOLKIT_DB", "database_name": "toolkit-db", "database_id": "78b99395-186d-44f5-854d-94aa85530f04", "migrations_dir": "migrations" }
  ],
  "//r2": "Toolkit V4 desktop files (docs/toolkit-v4-api.md section 3). Created 2026-10-28. Index lives in D1 table files.",
  "r2_buckets": [
    { "binding": "TOOLKIT_FILES", "bucket_name": "toolkit-files" }
  ],
  "//kv": "Spotify refresh token and one-time OAuth states for /api/now-playing. Namespace deependhq-spotify, created 2026-10-28.",
  "//pipelines": "AI query log: stream toolkit_ai_log_stream -> pipeline toolkit_ai_log -> sink toolkit_ai_log_sink -> Iceberg table default.toolkit_ai_log in R2 bucket toolkit-ai-log (Data Catalog). Cell values are redacted before send.",
  "pipelines": [
    { "binding": "AI_LOG", "stream": "a5bbc9fc2ebb4152aac04bf1f79db09b" }
  ],
  "kv_namespaces": [
    { "binding": "SPOTIFY_KV", "id": "47cdfed513bd4bda86640026b2aa67a4" }
  ],
  "//pipelines": "AI_LOG (Cloudflare Pipeline stream into Iceberg default.toolkit_ai_log, bucket toolkit-ai-log, catalog enabled) is NOT bound yet: the r2-data-catalog sink needs a catalog API token from Deep. Until then every AI call is logged to D1 ai_log only.",
  "//triggers": "Daily 21:17 UTC (02:47 IST): purge ai_log rows older than 180 days.",
  "triggers": { "crons": ["17 21 * * *"] },
  "//vars": "Plain, non-secret configuration. An admin is a Clerk user with a VERIFIED address in CLERK_ADMIN_EMAILS (checked server-side), or a uid in the CLERK_ADMIN_IDS secret. CLERK_JS_URL pins clerk-js v5 from our own Clerk Frontend API (ToolKit app, production instance on deependhq.com); v6 splits the UI into @clerk/ui, so bump deliberately and retest sign-in. CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY are Worker secrets.",
  "vars": {
    "CLERK_ADMIN_EMAILS": "deep1499@gmail.com",
    "CLERK_JS_URL": "https://clerk.deependhq.com/npm/@clerk/clerk-js@5.128.1/dist/clerk.browser.js"
  },
  "assets": {
    "//binding": "MUST be declared. Local wrangler does not auto-inject the ASSETS binding, so env.ASSETS was undefined and every page 500'd. Declaring it explicitly is correct on deployed Workers too.",
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "//run_worker_first": "Wrangler serves an exactly matching asset before the Worker runs. Without this list /field-notes answered 200 with field-notes.html and never reached the redirect, and the HTMLRewriter plus the security headers never ran on a normal page load. Every HTML route is listed so it hits the Worker first. Static assets (css, js, data.js, fonts, xml, images) keep the cheaper direct asset path. The five .txt files are listed so the Worker can add charset=utf-8 to their content type.",
    "//audio": "/audio/* runs the Worker first so the essay readings answer Range requests with 206. The asset store answers every Range request with the whole file and a 200, and a browser cannot seek in audio served that way.",
    "//entity_patterns": "CRITICAL. The prerenderer now emits post/<slug>/index.html and company/<slug>/index.html, which are EXACTLY matching assets. Listing only /post and /company let all 27 of them be served straight from the asset store with no CSP, no nosniff and no X-Frame-Options, verified live 2026-10-01. The /post/* and /company/* globs are what put the security headers back.",
    "run_worker_first": [
      "/",
      "/cta",
      "/command",
      "/enrich",
      "/sign-in",
      "/toolkit-app",
      "/toolkit-app.html",
      "/toolkit-signin",
      "/toolkit-signin.html",
      "/companies",
      "/company",
      "/company/*",
      "/field-notes",
      "/journey",
      "/lead-scorer",
      "/lead-scorer.html",
      "/account",
      "/account.html",
      "/toolkit.html",
      "/mission-log",
      "/now",
      "/og",
      "/pillars",
      "/privacy",
      "/post",
      "/post/*",
      "/toolkit",
      "/writing",
      "/404",
      "/api/*",
      "/audio/*",
      "/showcase*",
      "/robots.txt",
      "/llms.txt",
      "/llms-full.txt",
      "/agents.txt",
      "/humans.txt"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
