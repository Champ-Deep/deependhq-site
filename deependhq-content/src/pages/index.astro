---
// The deployed root of deependhq.com is served by the main site / Worker.
// This content engine owns only /journey, /toolkit, and /journey/field-notes.
// A direct hit on this app root falls through to the Journey feed.
const target = "/journey";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>deependhq content engine</title>
    <link rel="canonical" href={target} />
  </head>
  <body style="background:#0D0F14;color:#E8E4DC;font-family:system-ui,sans-serif;padding:40px">
    <p>Redirecting to <a href={target} style="color:#30E060">the Journey</a>.</p>
  </body>
</html>
