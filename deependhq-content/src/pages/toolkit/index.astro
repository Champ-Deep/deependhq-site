---
import Base from "../../layouts/Base.astro";
import toolkitData from "../../data/toolkit.json";

interface ToolkitItem {
  title: string;
  description: string;
  url: string;
  category: string;
}

const items = toolkitData as ToolkitItem[];

const categoryMeta: Record<string, { label: string; pill: string }> = {
  tool: { label: "Tool", pill: "pill-green" },
  repo: { label: "Repo", pill: "pill-blue" },
  skill: { label: "Skill", pill: "pill-gold" },
  resource: { label: "Resource", pill: "pill-muted" },
};

const tabs = [
  { label: "All", value: "all" },
  { label: "Tools", value: "tool" },
  { label: "Repos", value: "repo" },
  { label: "Skills", value: "skill" },
  { label: "Resources", value: "resource" },
];
---
<Base
  title="The Toolkit | deependhq"
  description="Tools, repos, skills, and resources from the workshop of Sreedeep Surapaneni."
>
  <div class="section wrap-wide">
    <header class="page-header">
      <h1>The Toolkit</h1>
      <p class="page-subtitle">Tools, repos, skills, and resources from the workshop.</p>
    </header>

    <div class="filter-bar" role="group" aria-label="Filter by category">
      {tabs.map((tab, i) => (
        <button
          type="button"
          class:list={["filter-pill", { "is-active": i === 0 }]}
          data-cat-filter={tab.value}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="toolkit-grid" id="toolkit-grid">
      {items.map((item) => {
        const meta = categoryMeta[item.category] ?? categoryMeta.resource;
        const isPlaceholder = item.url === "#";
        return (
          <a
            class="toolkit-card"
            href={item.url}
            data-category={item.category}
            target={isPlaceholder ? undefined : "_blank"}
            rel={isPlaceholder ? undefined : "noopener"}
            aria-disabled={isPlaceholder ? "true" : undefined}
          >
            <span class:list={["pill", meta.pill]}>{meta.label}</span>
            <h2 class="toolkit-card-title">{item.title}</h2>
            <p class="toolkit-card-desc">{item.description}</p>
            <span class="toolkit-card-foot">
              <svg
                class="ext-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </span>
          </a>
        );
      })}
    </div>

    <p class="journey-empty" id="toolkit-empty" hidden>
      No items in this category yet.
    </p>
  </div>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>("[data-cat-filter]");
    const cards = document.querySelectorAll<HTMLElement>(".toolkit-card");
    const empty = document.getElementById("toolkit-empty");

    function applyFilter(filter: string): void {
      let visible = 0;
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => {
          p.classList.remove("is-active");
          p.setAttribute("aria-pressed", "false");
        });
        pill.classList.add("is-active");
        pill.setAttribute("aria-pressed", "true");
        applyFilter(pill.dataset.catFilter || "all");
      });
    });
  </script>
</Base>
